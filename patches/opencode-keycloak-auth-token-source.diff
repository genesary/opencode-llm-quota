@@ -0,0 +1,65 @@
+/**
+ * A read-only token source for other plugins in the same OpenCode process
+ * (OpenCode v1). OpenCode v1 gives plugins no way to read another provider's
+ * credentials, and this plugin must stay the only one that obtains and
+ * refreshes the Keycloak token; so it publishes, under a versioned key of the
+ * process-wide symbol registry:
+ *
+ *   globalThis[Symbol.for("opencode-keycloak-auth/token-source@1")] = {
+ *     version: 1,
+ *     token(providerId: string): Promise<string | undefined>,
+ *   }
+ *
+ * `token()` resolves the current access token of that provider exactly like the
+ * provider's own requests do (stored credentials, single-flight refresh near
+ * expiry), or `undefined` when there is none: not logged in, not an OAuth
+ * credential, or a failed refresh. It never throws, never starts a login and
+ * never exposes the refresh token. It is a symbol and not an import because the
+ * plugins ship as independent single-file bundles.
+ *
+ * On OpenCode v2 it is not needed: the host API
+ * (`ctx.integration.connection.active/resolve`) gives other plugins the
+ * connection, refreshed through this plugin's `refresh`.
+ */
+export const TOKEN_SOURCE_KEY = Symbol.for("opencode-keycloak-auth/token-source@1");
+
+export interface TokenSource {
+  readonly version: 1;
+  token(providerId: string): Promise<string | undefined>;
+}
+
+type Getter = () => Promise<string | null | undefined>;
+
+interface Registry extends TokenSource {
+  readonly providers: Map<string, Getter>;
+}
+
+function registry(scope: Record<PropertyKey, unknown>): Registry {
+  const existing = scope[TOKEN_SOURCE_KEY] as Registry | undefined;
+  if (existing?.version === 1 && existing.providers instanceof Map) return existing;
+  const providers = new Map<string, Getter>();
+  const created: Registry = {
+    version: 1,
+    providers,
+    async token(providerId) {
+      const get = providers.get(providerId);
+      if (!get) return undefined;
+      try {
+        return (await get()) ?? undefined;
+      } catch {
+        return undefined;
+      }
+    },
+  };
+  Object.defineProperty(scope, TOKEN_SOURCE_KEY, { value: created, configurable: true });
+  return created;
+}
+
+/** Publish (or replace) the token getter of `providerId`. */
+export function publishTokenSource(
+  providerId: string,
+  getter: Getter,
+  scope: Record<PropertyKey, unknown> = globalThis as Record<PropertyKey, unknown>,
+): void {
+  registry(scope).providers.set(providerId, getter);
+}
