+++ b/test/token-source.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it, vi } from "vitest";
+import { createLoader } from "../src/loader.js";
+import { publishTokenSource, TOKEN_SOURCE_KEY, type TokenSource } from "../src/token-source.js";
+import { jsonFetch, testConfig } from "./helpers.js";
+
+const source = (scope: Record<PropertyKey, unknown>) => scope[TOKEN_SOURCE_KEY] as TokenSource;
+
+describe("token source for other plugins", () => {
+  it("is a versioned { version: 1, token(providerId) } object", async () => {
+    const scope: Record<PropertyKey, unknown> = {};
+    publishTokenSource("keycloak", async () => "jwt", scope);
+    expect(source(scope).version).toBe(1);
+    expect(await source(scope).token("keycloak")).toBe("jwt");
+    expect(await source(scope).token("other")).toBeUndefined();
+  });
+
+  it("never throws: a failing getter (refresh failed) gives undefined", async () => {
+    const scope: Record<PropertyKey, unknown> = {};
+    publishTokenSource(
+      "keycloak",
+      async () => {
+        throw new Error("invalid_grant");
+      },
+      scope,
+    );
+    expect(await source(scope).token("keycloak")).toBeUndefined();
+  });
+
+  it("is published by the loader, and resolves the live (refreshed) token", async () => {
+    const now = 1_000_000;
+    let stored = { type: "oauth" as const, access: "old", refresh: "r1", expires: now + 3_600_000 };
+    const auth = vi.fn(async () => stored);
+    const fetchImpl = jsonFetch([{ body: { access_token: "new", refresh_token: "r2", expires_in: 300 } }]);
+    const client = { auth: { set: vi.fn(async () => ({})) } };
+    const loader = createLoader(testConfig(), { client: client as never, fetchImpl, now: () => now });
+
+    await loader(auth as never, {} as never);
+    const published = (globalThis as Record<PropertyKey, unknown>)[TOKEN_SOURCE_KEY] as TokenSource;
+    expect(await published.token("keycloak")).toBe("old");
+
+    stored = { ...stored, expires: now + 1_000 }; // within the refresh leeway
+    expect(await published.token("keycloak")).toBe("new");
+    expect(fetchImpl.calls).toHaveLength(1);
+  });
+
+  it("is not published for a non-OAuth credential", async () => {
+    delete (globalThis as Record<PropertyKey, unknown>)[TOKEN_SOURCE_KEY];
+    const loader = createLoader(testConfig({ providerId: "api-key-provider" }), { client: {} as never });
+    await loader((async () => ({ type: "api", key: "sk" })) as never, {} as never);
+    const published = (globalThis as Record<PropertyKey, unknown>)[TOKEN_SOURCE_KEY] as
+      | TokenSource
+      | undefined;
+    expect(await published?.token("api-key-provider")).toBeUndefined();
+  });
+});
